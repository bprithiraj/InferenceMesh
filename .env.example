# Explicit zero-cost deterministic API demo; switch to http for a real model.
INFERENCEMESH_BACKEND_MODE=demo
INFERENCEMESH_ENVIRONMENT=development
INFERENCEMESH_REQUIRE_API_KEY=false
INFERENCEMESH_MAX_CONCURRENT_REQUESTS=4
INFERENCEMESH_MAX_CONCURRENT_PER_TENANT=2
INFERENCEMESH_MAX_QUEUE_DEPTH=16
INFERENCEMESH_QUEUE_WAIT_MS=1000
INFERENCEMESH_REQUESTS_PER_MINUTE=60
INFERENCEMESH_OUTPUT_TOKENS_PER_MINUTE=8192
# Metrics are disabled unless a separate secret is provided.
INFERENCEMESH_METRICS_API_KEY=
# Real Ollama profile (see docs/local-serving.md):
# INFERENCEMESH_BACKEND_MODE=http
# INFERENCEMESH_BACKENDS=[{"name":"ollama","public_model":"local-chat","upstream_model":"qwen2.5:0.5b","base_url":"http://127.0.0.1:11434/v1","tasks":["chat"],"capacity":2,"timeout_seconds":180}]
