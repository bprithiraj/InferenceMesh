INFERENCEMESH_ENVIRONMENT=development
INFERENCEMESH_LOG_LEVEL=INFO
INFERENCEMESH_REQUIRE_API_KEY=false
INFERENCEMESH_API_KEY=local-dev-key
INFERENCEMESH_MAX_CONCURRENT_REQUESTS=32
INFERENCEMESH_MAX_CONCURRENT_PER_TENANT=4
INFERENCEMESH_MAX_QUEUE_DEPTH=64
INFERENCEMESH_QUEUE_WAIT_MS=250
INFERENCEMESH_MAX_INPUT_CHARS=20000
INFERENCEMESH_MAX_OUTPUT_TOKENS=512
INFERENCEMESH_FAKE_TOKEN_DELAY_MS=5
